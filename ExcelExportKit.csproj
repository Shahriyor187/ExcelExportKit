<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>ExcelExportKit</PackageId>
    <Version>2.1.0-rc.1</Version>
    <!-- Compare against the actual published package, not a source snapshot. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>2.0.0</PackageValidationBaselineVersion>
    <Authors>Shahriyor Murodilov</Authors>
    <Description>Convert XLSX worksheets to CSV, TSV, typed JSON, styled PDF and DOCX. Supports stream and file conversions, row selection, progress reporting, batch conversion and configurable workbook input limits.</Description>
    <PackageTags>excel;xlsx;csv;tsv;json;pdf;word;docx;conversion;export;spreadsheet;streams;reporting</PackageTags>
    <PackageProjectUrl>https://github.com/Shahriyor187/ExcelExportKit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Shahriyor187/ExcelExportKit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="TerraPDF" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="examples/**/*.cs" />
    <!-- Explicit package includes are required for NuGet readme discovery. -->
    <None Remove="README.md;LICENSE.txt" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE.txt" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
