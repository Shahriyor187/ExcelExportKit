<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>ExcelExportKit</PackageId>
    <Version>1.1.0</Version>
    <Authors>Shahriyor Murodilov</Authors>
    <Description>Convert the first worksheet in an Excel workbook to CSV, JSON, PDF, or Word documents.</Description>
    <PackageTags>excel;xlsx;csv;json;pdf;word;docx;conversion;export</PackageTags>
    <PackageProjectUrl>https://github.com/Shahriyor187/ExcelExportKit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Shahriyor187/ExcelExportKit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="TerraPDF" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <None Update="README.md" Pack="true" PackagePath="\\" />
    <None Update="LICENSE" Pack="true" PackagePath="\\" />
  </ItemGroup>
</Project>
