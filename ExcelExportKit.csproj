<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>ExcelExportKit</PackageId>
    <Version>1.2.0</Version>
    <Authors>Shahriyor Murodilov</Authors>
    <Description>Convert selected Excel worksheets to CSV, typed JSON, PDF, or Word documents with batch export and optional PDF cell formatting.</Description>
    <PackageTags>excel;xlsx;csv;json;pdf;word;docx;conversion;export</PackageTags>
    <PackageProjectUrl>https://github.com/Shahriyor187/ExcelExportKit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Shahriyor187/ExcelExportKit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="TerraPDF" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <!-- Explicit package includes are required for NuGet readme discovery. -->
    <None Remove="README.md;LICENSE.txt" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE.txt" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
